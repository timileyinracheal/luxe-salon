<%- include('partials/header') %>
<section class="narrow-section"><div class="form-card">
  <span class="eyebrow">Pledge created</span><h1>Thank you for supporting Luxe Salon.</h1>
  <p>Your pledge for <strong><%= item.title %></strong> is pending until the bank transfer is received and verified.</p>
  <div class="reference-box"><span>Your private contribution reference</span><strong><%= contribution.paymentCode %></strong><p>Keep this code safe. Use it to check whether your contribution has been verified.</p></div>
  <% if (campaign.bankName && campaign.accountName && campaign.accountNumber) { %>
    <div class="bank-details"><h2>Bank transfer details</h2><dl><div><dt>Bank</dt><dd><%= campaign.bankName %></dd></div><div><dt>Account name</dt><dd><%= campaign.accountName %></dd></div><div><dt>Account number</dt><dd><%= campaign.accountNumber %></dd></div><div><dt>Amount</dt><dd><%= formatMoney(contribution.amountKobo) %></dd></div><div><dt>Transfer narration</dt><dd><%= contribution.paymentCode %></dd></div></dl></div>
  <% } else { %><div class="alert">Bank transfer details are not configured yet. Save your reference and contact the fundraiser owner for payment instructions.</div><% } %>
  <p class="fine-print">Only transfer using details confirmed by the fundraiser owner. The site does not collect or store banking passwords or card details.</p>
  <a class="button button-outline button-full" href="/contribution-status">Check contribution status</a>
</div></section>
<%- include('partials/footer') %>

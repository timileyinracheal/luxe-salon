<%- include('../partials/header') %>
<section class="narrow-section"><div class="form-card"><span class="eyebrow">Private administration</span><h1>Admin sign in</h1><p>Sign in to manage fundraiser items and verify bank transfers.</p>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/login" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email<input type="email" name="email" required autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="button button-primary button-full">Sign in</button></form>
</div></section>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<section class="section admin-section"><div class="section-heading"><div><span class="eyebrow">Contribution review</span><h1>Support pledges</h1><p>Confirm each bank transfer in your account before verifying it here.</p></div><a class="button button-outline" href="/admin">Back to dashboard</a></div>
  <nav class="filter-links"><a class="<%= status === 'pending' ? 'selected' : '' %>" href="/admin/contributions?status=pending">Pending</a><a class="<%= status === 'verified' ? 'selected' : '' %>" href="/admin/contributions?status=verified">Verified</a><a class="<%= status === 'rejected' ? 'selected' : '' %>" href="/admin/contributions?status=rejected">Rejected</a></nav>
  <% if (!contributions.length) { %><div class="empty-state"><h2>No <%= status %> contributions</h2><p>There are no contributions in this list.</p></div><% } %>
  <div class="contribution-list"><% contributions.forEach((contribution) => { %><article class="contribution-card"><div class="contribution-heading"><div><span class="eyebrow"><%= contribution.item ? contribution.item.title : 'Item unavailable' %></span><h2><%= formatMoney(contribution.amountKobo) %></h2></div><span class="badge badge-<%= contribution.status %>"><%= contribution.status %></span></div><dl><div><dt>Contributor</dt><dd><%= contribution.donorName %></dd></div><div><dt>Email</dt><dd><%= contribution.donorEmail || 'Not provided' %></dd></div><div><dt>Private code</dt><dd><%= contribution.paymentCode %></dd></div><div><dt>Transfer note</dt><dd><%= contribution.transferReference || 'Not provided' %></dd></div><div><dt>Payment proof</dt><dd><% if (contribution.proofUrl) { %><a href="<%= contribution.proofUrl %>" target="_blank" rel="noopener noreferrer">View uploaded proof</a><% } else { %>Not provided<% } %></dd></div><div><dt>Submitted</dt><dd><%= new Date(contribution.createdAt).toLocaleString() %></dd></div></dl>
    <form method="post" action="/admin/contributions/<%= contribution._id %>/status" class="review-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Admin note <input name="adminNote" maxlength="500" value="<%= contribution.adminNote || '' %>" placeholder="Optional private note"></label><div><button name="status" value="verified" class="button button-primary">Verify transfer</button><button name="status" value="rejected" class="button button-danger">Reject</button></div></form>
  </article><% }) %></div>
</section>
<%- include('../partials/footer') %>
